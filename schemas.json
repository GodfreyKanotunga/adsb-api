{
    "getData": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "getData response",
        "type": "object",
        "required": ["code", "msg", "req", "sqltime"],
        "properties": {
            "code": {"type": "integer", "enum": [0, 1]},
            "msg": {"type": "string"},
            "req": {"type": "string", "const": "getData"},
            "sqltime": {"type": "number", "minimum": 0},
            "count": {"type": "integer", "minimum": 0, "maximum": 500},
            "results": {
                "type": "array",
                "maxItems": 500,
                "items": {
                    "type": "object",
                    "required": ["date_time", "flight_num", "geo"],
                    "properties": {
                        "date_time": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"},
                        "flight_num": {"type": ["string", "null"]},
                        "gs": {"type": ["number", "null"]},
                        "geo": {"type": ["string", "null"]}
                    },
                    "additionalProperties": true
                }
            }
        }
    },
    "countInPolygon": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "countInPolygon response",
        "type": "object",
        "required": ["code", "msg", "req", "sqltime"],
        "properties": {
            "code": {"type": "integer", "enum": [0, 1]},
            "msg": {"type": "string"},
            "req": {"type": "string", "const": "countInPolygon"},
            "sqltime": {"type": "number", "minimum": 0},
            "polygon": {"type": "string"},
            "count": {"type": "integer", "minimum": 0}
        }
    },
    "getAvgSpeedByFlight": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "getAvgSpeedByFlight response",
        "type": "object",
        "required": ["code", "msg", "req", "sqltime"],
        "properties": {
            "code": {"type": "integer", "enum": [0, 1]},
            "msg": {"type": "string"},
            "req": {"type": "string", "const": "getAvgSpeedByFlight"},
            "sqltime": {"type": "number", "minimum": 0},
            "start": {"type": ["string", "null"]},
            "end": {"type": ["string", "null"]},
            "count": {"type": "integer", "minimum": 0, "maximum": 500},
            "results": {
                "type": "array",
                "maxItems": 500,
                "items": {
                    "type": "object",
                    "required": ["flight", "avgspeed"],
                    "properties": {
                        "flight": {"type": ["string", "null"]},
                        "avgspeed": {"type": ["number", "null"]}
                    }
                }
            }
        }
    }
}
